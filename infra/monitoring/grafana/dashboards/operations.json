{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "type": "timeseries",
      "title": "API request latency P95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(renewableops_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "P95"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "5xx requests",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(renewableops_http_requests_total{status=~\"5..\"}[1h]))"
        }
      ],
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 }
    },
    {
      "type": "logs",
      "title": "Correlated API logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{service=\"renewableops-api\"}" }],
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 }
    }
  ],
  "schemaVersion": 41,
  "tags": ["renewableops", "portfolio"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "RenewableOps · Platform health",
  "uid": "renewableops-health",
  "version": 1
}
